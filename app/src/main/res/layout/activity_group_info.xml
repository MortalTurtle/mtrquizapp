<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/back"
    android:padding="16dp">

    <TextView
        android:id="@+id/groupNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/comfortaa_light"
        android:text="Group name"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/groupCodeTextView"
        android:layout_width="361dp"
        android:layout_height="36dp"
        android:layout_marginTop="76dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa_light"
        android:singleLine="true"
        android:text="Group code"
        android:textIsSelectable="true"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/groupDescriptionTextView"
        android:layout_width="357dp"
        android:layout_height="92dp"
        android:layout_marginTop="124dp"
        android:fontFamily="@font/comfortaa_light"
        android:text="Group description"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/editGroupButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#b993c7"
        android:fontFamily="@font/comfortaa_light"
        android:text="Edit Group"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/groupDescriptionTextView" />

    <Button
        android:id="@+id/manageTestsButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#b993c7"
        android:fontFamily="@font/comfortaa_light"
        android:text="Manage Tests"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/editGroupButton"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/joinAnotherGroupButton"
        android:layout_width="157dp"
        android:layout_height="70dp"
        android:layout_marginTop="52dp"
        android:backgroundTint="#b993c7"
        android:fontFamily="@font/comfortaa_light"
        android:text="Join Another"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/manageTestsButton" />

</androidx.constraintlayout.widget.ConstraintLayout>